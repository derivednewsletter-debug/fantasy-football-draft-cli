{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "VERCEL_ENV": "1",
    "LEAGUES_DIR": "/tmp/leagues"
  }
}

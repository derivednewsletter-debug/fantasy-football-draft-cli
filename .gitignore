# Environment variables with API keys
.env

# League data (persistent draft states)
leagues/*
!leagues/.gitkeep

# User data (per-user league files, excluded for security)
users/*
!users/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# SQLite database files (auto-created, not committed)
data/app.db

# OS junk
.DS_Store

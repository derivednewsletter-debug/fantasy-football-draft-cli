# Database connection
# ──────────────────────────────────────────────
# Leave empty → uses SQLite at data/app.db (local dev)
# Set to a Postgres connection string → uses Postgres (Vercel / production)
#
# Get a free Postgres database from Neon:
#   1. Go to https://neon.tech and sign in with GitHub
#   2. Create a project → copy the connection string
#   3. Set this env var in your Vercel project dashboard
#
DATABASE_URL=

# NVIDIA API key for AI-powered draft recommendations
# Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=
